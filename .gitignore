target/
.vscode/

# proptest records failing inputs here; they are machine-local findings, not
# fixtures — a real one becomes a named test in tests/soundness_test.rs.
*.proptest-regressions

# Scratch images from running repros by hand at the repo root. The tests
# write only under their own scratch directories; nothing in the tree is a
# committed image, and the corpora are external and opt-in.
/*.exr
/span-demo/

# Review analysis that names upstream people stays local and out of this
# public fork. Lives in F:\prjs\oiio-bind-private\ instead.
contrib/draft-corrections.md
contrib/*-private.md

# A report that is finished but not filed stays out of a public fork: the
# name alone invites the question of why it was not just filed, and the
# answer is nobody's business but ours. They live in F:\prjs\oiio-bind-private\
# until they are filed, and come back renamed for the issue number.
contrib/*ready-to-file*.md

# Working notes written to Kim rather than to a reader of this repository.
contrib/session-*.md
