target/
.vscode/

# proptest records failing inputs here; they are machine-local findings, not
# fixtures — a real one becomes a named test in tests/soundness_test.rs.
*.proptest-regressions

# Scratch images from running repros by hand at the repo root. The tests
# write only under their own scratch directories; nothing in the tree is a
# committed image, and the corpora are external and opt-in.
/*.exr
/span-demo/

# Upstream defect notes stay out of this repository. A report is worth
# reading once it is filed, and the filed issue carries its own context, so
# what is left here is a short list of the filed ones in SECURITY.md and
# ROADMAP.md. The working notes, drafts and reproductions live in
# F:\prjs\oiio-bind-private\, outside any git repository.
contrib/upstream-issues.md
contrib/draft-corrections.md
contrib/issue-*.md
contrib/filed-*.md
contrib/*ready-to-file*.md
contrib/*-private.md
contrib/*_repro.cpp

# Working notes written to Kim rather than to a reader of this repository.
contrib/session-*.md
